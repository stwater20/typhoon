rules_version = '2';

// 網友開票所的 Firestore 安全規則。
//
// 資料結構：
//   days/{date}                 計票，欄位如 TPE_yes / TPE_no（整數），任何人可讀
//   days/{date}/votes/{uid}     每個匿名使用者每天一票：{ county, choice, ts }
//   results/{date}              官方公告結果，如 { TPE: "off", KHH: "on" }，只能從 Firebase 主控台寫入
//
// 規則保證：投票紀錄與計票必須在同一個 batch 寫入、每次只能 +1、一人一天一票、投了不能改，
// 而且只能在 D-2 日 00:00 到 D-1 日 19:00（台灣時間）之間投票。時間要和 assets/js/vote.js 的 pollTimes() 一致。
service cloud.firestore {
  match /databases/{database}/documents {

    function counties() {
      return ['PIF', 'KHH', 'TNN', 'HUA', 'CYQ', 'PEN', 'TTT', 'CYI', 'ILA', 'YUN', 'NAN',
              'NWT', 'LIE', 'TPE', 'KEE', 'CHA', 'TXG', 'HSQ', 'KIN', 'TAO', 'HSZ', 'MIA'];
    }

    // date 對應的台灣時間 D 日 00:00 = UTC D 日 00:00 - 8h
    function votingOpen(date) {
      let p = date.split('-');
      let utcMidnight = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= utcMidnight - duration.value(56, 'h')
        && request.time < utcMidnight - duration.value(13, 'h');
    }

    function votePath(date) {
      return /databases/$(database)/documents/days/$(date)/votes/$(request.auth.uid);
    }

    function dayPath(date) {
      return /databases/$(database)/documents/days/$(date);
    }

    function tallyIncrementedBy(vote) {
      let key = vote.county + '_' + vote.choice;
      return resource == null
        ? request.resource.data.keys().hasOnly([key]) && request.resource.data[key] == 1
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly([key])
          && request.resource.data[key] == resource.data.get(key, 0) + 1;
    }

    match /days/{date} {
      allow read: if true;

      // 只能在同一個 batch 新增自己的投票紀錄時，把對應欄位 +1
      allow create, update: if request.auth != null
        && votingOpen(date)
        && !exists(votePath(date))
        && existsAfter(votePath(date))
        && tallyIncrementedBy(getAfter(votePath(date)).data);

      match /votes/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && votingOpen(date)
          && request.resource.data.keys().hasOnly(['county', 'choice', 'ts'])
          && request.resource.data.county in counties()
          && request.resource.data.choice in ['yes', 'no']
          && request.resource.data.ts == request.time
          && getAfter(dayPath(date)).data.get(request.resource.data.county + '_' + request.resource.data.choice, 0)
             == (exists(dayPath(date))
                 ? get(dayPath(date)).data.get(request.resource.data.county + '_' + request.resource.data.choice, 0)
                 : 0) + 1;

        allow update, delete: if false;
      }
    }

    match /results/{date} {
      allow read: if true;
      allow write: if false; // 請在 Firebase 主控台手動填入官方公告
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
